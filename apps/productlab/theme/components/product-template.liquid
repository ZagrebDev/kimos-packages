{% assign es_personalizado = false %}
{% for field in product.fields %}
	{% if field.label == 'diseno' and field.value == 'personalizado' %}
		{% assign es_personalizado = true %}
	{% endif %}
{% endfor %}

{% if es_personalizado %}
	<!-- ═══════════════════════════════════════════════════════════════════
	     ProductLab — DISEÑO PERSONALIZADO (3 pestañas)
	     EXPLORAR (hero/secciones de la app) · CONFIGURAR (variantes) ·
	     ESPECIFICACIONES
	     Se activa con el custom field del producto: diseno = personalizado.
	     El precio cobrado es el de la VARIANTE Jumpseller (server-side); el
	     JSON público de ProductLab aporta presentación (fotos, specs,
	     compatibilidades, pasos condicionales, estilo).
	     JS: assets/configurador.js · CSS: assets/configurador.css
	     ═══════════════════════════════════════════════════════════════════ -->
	{% assign first_variant = product.variants.first | default: product %}
	{% capture t_add_to_cart_default %}{% t "Add to Cart" %}{% endcapture %}
	{% assign t_add_to_cart = options.t_add_to_cart | default: t_add_to_cart_default %}

	<link rel="stylesheet" href="{{ 'configurador.css' | asset }}">
	<script src="{{ 'configurador.js' | asset }}" defer></script>

	<section
		id="product-template-{{ product.id }}"
		class="container-fluid theme-section product-page personalizador-layout pp-conf"
		data-bundle-color="{{ component.options.bundle_color }}"
		data-pp-configurador
		data-kimos-url="{{ component.options.kimos_url | strip_html | strip | escape }}"
		data-product-id="{{ product.id }}"
		data-sku="{{ product.sku | escape }}"
		data-product-name="{{ product.name | escape }}"
		data-product-image="{% if product.images.first %}{{ product.images.first | resize: '1000' }}{% endif %}"
		data-pp-locale="{{ component.options.pp_locale | default: 'es-CL' }}"
		data-pp-currency-prefix="{{ component.options.pp_currency_prefix | default: '$' }}"
		{{ component.attributes }}
	>
		<script type="application/json" class="product-json" data-productid="{{ product.id }}">
			{{ product | json }}
		</script>

		<!-- Barra de pestañas: pegada al header, fija al hacer scroll, con
		     mini-foto + precio "desde". Títulos configurables desde la app
		     (storefront.tabs). -->
		<div class="pp-tabs" role="tablist" data-pp-bar>
			<div class="pp-tabs-inner container theme-section__container">
				<button type="button" class="pp-tab pp-tab-model on" data-tab="landing" role="tab" data-pp-tablabel="explorar">{{ product.name }}</button>
				<button type="button" class="pp-tab" data-tab="landing" data-scroll="#pp-espec" role="tab" data-pp-tablabel="specs">Especificaciones</button>
				<button type="button" class="pp-tab" data-tab="landing" data-scroll="#pp-fotos" role="tab" data-pp-tablabel="fotos">Fotos</button>
				<div class="pp-bar-mini" data-pp-mini aria-hidden="true">
					<img data-pp-photo src="{% if product.images.first %}{{ product.images.first | resize: '300' }}{% endif %}" alt="">
					<span class="pp-bar-mini-price"><small>Desde</small> {{ first_variant.price | minus: first_variant.discount | price }}</span>
				</div>
				<button type="button" class="pp-tab pp-tab-buy" data-tab="configurar" role="tab" data-pp-tablabel="comprar">Comprar →</button>
			</div>
		</div>

		<!-- ── LANDING: hero + secciones + especificaciones + fotos ── -->
		<div class="pp-panel on pp-landing" data-panel="landing">
			<div class="pp-boot" data-pp-boot><div class="pp-spin" role="status" aria-label="Cargando"></div></div>
			<div data-pp-hero>
				<!-- Fallback previo al JS: hero mínimo con la foto del producto -->
				<div class="pp-hero" data-pos="center" data-valign="center" data-size="m" data-float="0">
					<div class="pp-hero-title">
						<h1>{{ product.name }}</h1>
						{% if product.sku != blank %}<div class="pp-hero-sku">SKU · {{ product.sku }}</div>{% endif %}
					</div>
					<div class="pp-hero-inner">
						<div class="pp-hero-items left"></div>
						<div class="pp-hero-photo">
							{% if product.images.first %}
								<img src="{{ product.images.first | resize: '1000' }}" alt="{{ product.name | escape }}">
							{% endif %}
						</div>
						<div class="pp-hero-items right"></div>
					</div>
					<div class="pp-hero-ctas">
						<button type="button" class="pp-btn pp-btn-primary" data-pp-goto="configurar">Configurar →</button>
					</div>
				</div>
			</div>
			<!-- Secciones/slides configurables desde la app (storefront.sections) -->
			<div data-pp-sections></div>

			<!-- Especificaciones (ancla #pp-espec) -->
			<div id="pp-espec" class="pp-specs" data-pp-specs>
				{% if product.description != blank %}
					<div class="pp-specs-empty">{{ product.description }}</div>
				{% endif %}
			</div>

			<!-- Fotos (ancla #pp-fotos): título + grilla de miniaturas; el JS
			     agrega el visor en línea al elegir una foto y la nota al pie
			     (storefront.photosNote) si la app la define. -->
			<div id="pp-fotos" class="pp-fotos-block container theme-section__container">
				<div class="pp-specs-heading" data-pp-tablabel="fotos">Fotos</div>
				<div class="pp-fotos" data-pp-fotos-grid>
					{% for image in product.images %}
						<a class="pp-foto" href="{{ image | resize: '1600' }}" target="_blank" rel="noopener">
							<img loading="lazy" src="{{ image | resize: '900' }}" alt="{{ product.name | escape }} — foto {{ forloop.index }}">
						</a>
					{% endfor %}
					{% if product.images.size == 0 %}
						<div class="pp-specs-empty">Este modelo aún no tiene fotos cargadas.</div>
					{% endif %}
				</div>
				<div class="pp-fotos-note" data-pp-fotos-note hidden></div>
			</div>
		</div>

		<!-- ── 02 CONFIGURAR ── -->
		<div class="pp-panel" data-panel="configurar">
			<div class="pp-config">
				<div class="pp-steps" data-pp-steps>
					<div class="pp-spin" role="status" aria-label="Cargando configurador"></div>
					<p style="color:#9D9D9C; font-size:13px; text-align:center;">Cargando configurador…</p>
				</div>

				<div class="pp-panel-box">
					<div class="pp-panel-head">
						<div class="name">{{ product.name }}</div>
						{% if product.sku != blank %}<div class="sku">SKU · {{ product.sku }}</div>{% endif %}
					</div>
					<div class="pp-panel-body">
						<div class="pp-panel-photo" data-pp-panel-photo>
							<img data-pp-photo src="{% if product.images.first %}{{ product.images.first | resize: '600' }}{% endif %}" alt="{{ product.name | escape }}">
						</div>
						<div>
							<div class="pp-price-label">Precio configurado</div>
							<div class="pp-price product-price" data-pp-price>{{ first_variant.price | minus: first_variant.discount | price }}</div>
							<div class="pp-delivery" data-pp-delivery></div>
						</div>
						<div class="pp-summary" data-pp-summary></div>
						<div class="pp-notice" data-pp-notice></div>
						<div class="pp-stockmsg" data-pp-stockmsg></div>

						<product-form class="product-form product-form-{{ component.id }}" {{ component.attributes }}>
							<script type="application/json" class="product-form-json">
								{
									"options": {
										"disableShoppingCart": {{ options.disable_shopping_cart | json }},
										"disableShoppingCartTitle": {{ options.disable_shopping_cart_title | json }},
										"disableShoppingCartText": {{ options.disable_shopping_cart_text | json }},
										"disableShoppingCartContact": {{ options.disable_shopping_cart_contact | json }},
										"disableShoppingCartWhatsapp": {{ options.disable_shopping_cart_whatsapp | json }}
									},
									"info": {
										"product": {
											"id": {{ product.id | json }},
											"sku": {{ product.sku | json }},
											"type": {{ product.type | json }},
											"name": {{ product.name | json }},
											"url": {{ product.url | json }},
											"add_to_cart_url": {{ product.add_to_cart_url | json }},
											"back_in_stock_url": {{ product.back_in_stock_url | json }},
											"back_in_stock_enabled": {{ product.back_in_stock_enabled | json }},
											"stock": {{ product.stock | json }},
											"stock_notification": {{ product.stock_notification | json }},
											"stock_threshold": {{ product.stock_threshold | json }},
											"stock_unlimited": {{ product.stock_unlimited | json }},
											"status": {{ product.status | json }},
											"options": {{ product.options | json }},
											"option_types": {{ product.options | map: 'type' | json }},
											"minimum_quantity": {{ product.minimum_quantity | json }},
											"maximum_quantity": {{ product.maximum_quantity | json }},
											"share_url": {{ store.base_url | append: product.url | json }},
											"quotable": {{ product.quotable | json }},
											"request_quote_url": {{ product.request_quote_url | json }}
										},
										"variant": {
											"id": {{ first_variant.id | json }},
											"stock": {{ first_variant.stock | json }},
											"stock_notification": {{ first_variant.stock_notification | json }},
											"stock_threshold": {{ first_variant.stock_threshold | json }},
											"stock_unlimited": {{ first_variant.stock_unlimited | json }},
											"status": {{ first_variant.status | json }},
											"price": {{ first_variant.price | json }},
											"price_with_discount": {{ first_variant.price | minus: first_variant.discount | json }},
											"minimum_quantity": {{ product.minimum_quantity | json }},
											"maximum_quantity": {{ product.maximum_quantity | json }}
										},
										"contact": { "url": {{ contact.url | json }} },
										"social": { "whatsapp": { "url": {{ social.whatsapp.url | json }} } },
										"status": {
											"outOfStockTitle": {{ options.t_out_of_stock_pf | json }},
											"outOfStockText": {{ options.t_out_of_stock_pf_text | json }},
											"notAvailableTitle": {{ options.t_not_available_pf | json }},
											"notAvailableText": {{ options.t_not_available_pf_text | json }},
											"buttonContact": {{ options.pf_status_button_contact | json }},
											"buttonWhatsapp": {{ options.pf_status_button_whatsapp | json }}
										}
									}
								}
							</script>

							<form action="{{ product.add_to_cart_url }}" method="post" enctype="multipart/form-data" name="buy">
								<!-- Selects nativos ocultos: el JS del theme los usa para el
								     matching de variante, la URL y el add-to-cart AJAX; las
								     cards del configurador los manejan (incluidos los pasos
								     condicionales ocultos, que quedan en su default). -->
								<div class="variants pp-variants-native" aria-hidden="true">
									{% for option in product.options %}
										<select
											class="prod-options"
											name="{{ option.id }}"
											data-optionid="{{ option.id }}"
											data-optionname="{{ option.name | escape }}"
											tabindex="-1"
										>
											{% for value in option.values %}
												<option value="{{ value.id }}" data-name="{{ value.name | escape }}">{{ value.name }}</option>
											{% endfor %}
										</select>
									{% endfor %}
								</div>

								<!-- Cantidad oculta + contenedores que el custom element ProductForm
								     del theme espera (su buildProductForm lee .product-form__input.value
								     sin guard). -->
								<input
									type="number"
									class="product-form__input pp-hidden"
									value="{{ product.minimum_quantity | default: 1 | at_least: 1 }}"
									min="1"
									aria-hidden="true"
									tabindex="-1"
								>
								<div class="product-form__handler"></div>
								<div class="product-form__actions">
									{% assign option_types = product.options | map: 'type' -%}
									{% if options.display_cart_notification == false or option_types contains 'file' %}
										<button type="submit" class="pp-btn pp-btn-primary" id="add-to-cart">
											<span>{{ t_add_to_cart }} →</span>
										</button>
									{% else %}
										<button type="button" class="pp-btn pp-btn-primary" id="add-to-cart">
											<span>{{ t_add_to_cart }} →</span>
										</button>
									{% endif %}
								</div>
							</form>
						</product-form>
					</div>
				</div>
			</div>
		</div>


	</section>

{% else %}
	<!-- ═══════════════════════════════════════════════════════════════════
	     DISEÑO ESTÁNDAR — de aquí hacia abajo va el product-template
	     ORIGINAL del theme anfitrión, SIN cambios. La rama incluida abajo es
	     la del theme Streamly; si instalas este kit en otro theme, reemplaza
	     todo el contenido de este {% else %} por el product-template original
	     de ese theme.
	     ═══════════════════════════════════════════════════════════════════ -->
	<style>
		#product-template-{{ product.id }} {
			--theme-max-width: {{ options.theme_width }};
			--section-margin-top: {{ component.options.margin_top }}px;
			--section-margin-bottom: {{ component.options.margin_bottom }}px;
			--product-page-alignment: {{ component.options.text_alignment }};
		}
	</style>

	<section
		id="product-template-{{ product.id }}"
		class="container-fluid theme-section product-page text-{{ component.options.text_alignment }}"
		data-bundle-color="{{ component.options.bundle_color }}"
		{% if options.theme_animate %}
			data-aos-once="{% if component.options.animate %}{{ component.options.animate_repeat }}{% else %}{{ options.theme_animate_repeat }}{% endif %}"
			data-aos="{% if component.options.animate %}{{ component.options.animate_type }}{% else %}{{ options.theme_animate_type }}{% endif %}"
			data-aos-delay="{% if component.options.animate %}{{ component.options.animate_delay }}{% else %}{{ options.theme_animate_delay }}{% endif %}"
		{% endif %}
		{{ component.attributes }}
	>
		<script type="application/json" class="product-json" data-productid="{{ product.id }}">
			{{ product | json }}
		</script>

		<div class="container theme-section__container">
			<div
				class="row theme-section__content product-page__wrapper"
				data-gap="{{ component.options.content_gap }}"
				data-order-reversed="{{ component.options.columns_order }}"
			>
				<div class="col-12 col-md theme-section__column product-gallery">
					{% render 'product_gallery', prod: product %}
				</div>

				<div class="col-12 col-md theme-section__column product-page__content">
					<div class="product-page__info">
						{% for child in component.children %}
							{% case child.property %}
								{% when 'attributes' %}
									{% render 'components/product-attributes', product-attributes: child, prod: product %}
								{% when 'title' %}
									{% render 'components/product-title', product-title: child, prod: product %}
								{% when 'price' %}
									{% render 'components/product-price', product-price: child, prod: product %}
								{% when 'volume-prices' %}
									{% render 'components/product-volume-prices', product-volume-prices: child, prod: product %}
								{% when 'reviews-stars' %}
									{% render 'components/product-reviews-stars', product-reviews-stars: child, prod: product %}
								{% when 'stock' %}
									{% render 'components/product-stock', product-stock: child, prod: product %}
								{% when 'form' %}
									{% render 'components/product-form', product-form: child, prod: product %}
								{% when 'notification' %}
									{% render 'components/product-notification', product-notification: child %}
								{% when 'stock-locations' %}
									{% render 'components/product-stock-locations', product-stock-locations: child, prod: product %}
								{% when 'wishlist' %}
									{% render 'components/product-wishlist', product-wishlist: child, prod: product %}
								{% when 'description' %}
									{% render 'components/product-description', product-description: child, prod: product %}
								{% when 'fields' %}
									{% render 'components/product-fields', product-fields: child, prod: product %}
								{% when 'accordion' %}
									{% render 'components/product-accordion', product-accordion: child, prod: product %}
								{% when 'attachments' %}
									{% render 'components/product-attachments', product-attachments: child, prod: product %}
								{% when 'line-divider' %}
									{% render 'components/product-line-divider', product-line-divider: child, prod: product %}
								{% when 'share' %}
									{% render 'components/product-share', product-share: child, prod: product %}
								{% when 'product-custom-code' %}
									{% render 'components/product-custom-code', product-custom-code: child %}
							{% endcase %}
						{% endfor %}
					</div>
					<!-- end .product-page__info -->
				</div>
			</div>
		</div>
	</section>

	{% for child in component.children %}
		{% case child.property %}
			{% when 'stock-locations' %}
				{% render 'product_stock_locations', product-stock-locations: child, prod: product %}
		{% endcase %}
	{% endfor %}
{% endif %}
